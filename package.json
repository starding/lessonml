{
  "name": "lessonml",
  "version": "0.1.0",
  "description": "A screenplay language for interactive, narrative lessons, designed to be written by language models.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src", "SPEC.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run build && node dist/scripts/check.js",
    "serve": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
